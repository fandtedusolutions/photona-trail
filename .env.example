# ==============================================================================
# Photona Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django & Security Settings
# ------------------------------------------------------------------------------
# In production, set DEBUG=False and generate a strong secret key
DEBUG=True
SECRET_KEY=django-insecure-k=#c68^lci2k!9kadhvtoyo@-53epmu*6%vp4goi_x1+6i3)mg
ALLOWED_HOSTS=photona.weddinghillage.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. Redis & High-Speed Cache Settings (Required for Celery & AI Face Indexing)
# ------------------------------------------------------------------------------
# Setting USE_REDIS_CACHE=True enables instant 1ms album loads & real-time job sync
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 3. Google Drive Ultra-Fast Import Configuration
# ------------------------------------------------------------------------------
# GDRIVE_API_KEY is used for folder metadata listing
GDRIVE_API_KEY=AIzaSyDZFAogZjP68pKBPID99XDobk6-8HfNxJ8
# Number of parallel download streams (Recommended: 8 for high-speed multi-core servers)
GDRIVE_WORKERS=8

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL for Production)
# ------------------------------------------------------------------------------
# If left commented out, SQLite will be used locally. For PostgreSQL in production:
# DB_NAME=photona_db
# DB_USER=photona_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
# CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 5. AWS S3 Storage Settings (Optional)
# ------------------------------------------------------------------------------
# Set USE_S3 to True to upload images directly to AWS S3 bucket.
USE_S3=False
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION_NAME=us-east-1
# USE_S3_STATIC=False

# ------------------------------------------------------------------------------
# 6. Natdemy WhatsApp Template Notification Settings
# ------------------------------------------------------------------------------
