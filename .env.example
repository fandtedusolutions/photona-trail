# ==============================================================================
# Photona Production Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual production values.
# NEVER commit the real .env file with production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django & Security Settings
# ------------------------------------------------------------------------------
# In production, set DEBUG=False and generate a strong secret key
DEBUG=False
SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=your_domain.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. Redis & High-Speed Cache Settings (Required for Celery & AI Face Indexing)
# ------------------------------------------------------------------------------
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 3. Google Drive Ultra-Fast Import Configuration
# ------------------------------------------------------------------------------
# GDRIVE_API_KEY is used for folder metadata listing
GDRIVE_API_KEY=your_google_drive_api_key_here
# Number of parallel download streams (Recommended: 8 for high-speed multi-core servers)
GDRIVE_WORKERS=8

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL for Production)
# ------------------------------------------------------------------------------
# DB_NAME=photona_db
# DB_USER=photona_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
# CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 5. AWS S3 Storage Settings (Optional)
# ------------------------------------------------------------------------------
USE_S3=False
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_STORAGE_BUCKET_NAME=your_bucket_name_here
# AWS_S3_REGION_NAME=us-east-1
# USE_S3_STATIC=False

# ------------------------------------------------------------------------------
# 6. Natdemy WhatsApp Template Notification Settings
# ------------------------------------------------------------------------------
ENABLE_WHATSAPP_LINK_SEND=False
WAPP_API_URL=https://wapp.natdemy.com/api/v1/messages/template
WAPP_API_KEY=your_whatsapp_api_key_here
WAPP_API_SECRET=your_whatsapp_api_secret_here
WAPP_TEMPLATE_NAME=sahodhaya_1
WAPP_LANGUAGE=en_US

# ------------------------------------------------------------------------------
# 7. AI Performance Tuning
# ------------------------------------------------------------------------------
FACE_INFERENCE_CONCURRENCY=2
EMBED_CACHE_MAX_EVENTS=8
